<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 for the standalone relay; netstandard2.1 so the SAME relay can be hosted
         in-process by the BepInEx plugin on a dedicated game server (Unity Mono). -->
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>NORS.Server.Core</AssemblyName>
    <RootNamespace>NORS.Server.Core</RootNamespace>
    <Product>Nuclear Option Radio System - Relay Core</Product>
    <Version>0.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NORS.Common\NORS.Common.csproj" />
  </ItemGroup>

</Project>
