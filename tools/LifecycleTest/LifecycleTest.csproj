<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PluginSource Condition="'$(PluginSource)' == ''">$(MSBuildThisFileDirectory)../../src/NORS.Plugin/NorsPlugin.cs</PluginSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(PluginSource)" Link="Production/NorsPlugin.cs" />
  </ItemGroup>
</Project>
